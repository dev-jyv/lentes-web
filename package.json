{
  "name": "lentes-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:gen": "orval",
    "api:sync": "cp ../lentes-api/api/openapi.yaml openapi/openapi.yaml && orval",
    "typecheck": "next typegen && tsc --noEmit",
    "emails:export": "email export --dir emails --outDir emails/out",
    "emails:sync": "pnpm emails:export && mkdir -p ../lentes-api/internal/email/templates && cp emails/out/*.html ../lentes-api/internal/email/templates/"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@opennextjs/cloudflare": "^1.20.17",
    "@sentry/nextjs": "^11.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^26.7.2",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "posthog-js": "^1.450.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "orval": "^8.48.0",
    "react-email": "^6.11.15",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  },
  "packageManager": "pnpm@11.1.3"
}
