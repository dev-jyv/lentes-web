{
  "name": "lentes-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:gen": "orval",
    "api:sync": "cp ../lentes-api/api/openapi.yaml openapi/openapi.yaml && orval",
    "typecheck": "next typegen && tsc --noEmit",
    "emails:export": "email export --dir emails --outDir emails/out",
    "emails:sync": "pnpm emails:export && mkdir -p ../lentes-api/internal/email/templates && cp emails/out/*.html ../lentes-api/internal/email/templates/"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@sentry/nextjs": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "posthog-js": "^1.438.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "orval": "^8.44.0",
    "react-email": "^6.11.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@11.1.3"
}
